            "examples": [
              "demo@example.com"
            ]
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "writeOnly": true,
            "description": "1~1024 UTF-8 바이트. 공백을 제거하지 않는다. 짝이 없는 surrogate escape는 거부한다."
