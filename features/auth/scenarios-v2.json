{
  "profile": "browser-session-v2",
  "version": "0.2.0",
  "schema_version": 1,
  "openapi": "features/auth/openapi-v2.json",
  "backends": [
    "python",
    "go",
    "java",
    "rust"
  ],
  "note": "정적 근거 맵이다. 메서드·제목·백엔드 집합 검사는 테스트 실행 또는 통과를 뜻하지 않는다.",
  "suites": [
    {
      "id": "common-http",
      "kind": "unittest",
      "source": "tests/conformance.py",
      "class": "AuthContract",
      "scope": "each-backend",
      "reuses": "features/auth/scenarios.json",
      "cases": [
        {
          "id": "V2-AUTH-01",
          "test": "test_01_login_user_shape_and_cache",
          "description": "사용자 응답·CSRF 난수·캐시 방지"
        },
        {
          "id": "V2-AUTH-02",
          "test": "test_02_cookie_policy",
          "description": "쿠키 수명·경로·HttpOnly·SameSite"
        },
        {
          "id": "V2-AUTH-03",
          "test": "test_03_me_and_forged_session",
          "description": "내 정보·비로그인·변조 쿠키"
        },
        {
          "id": "V2-AUTH-04",
          "test": "test_04_email_normalization",
          "description": "이메일 공백 제거·소문자 정규화"
        },
        {
          "id": "V2-AUTH-05",
          "test": "test_05_generic_credentials_error",
          "description": "존재하지 않는 계정과 비밀번호 오류 응답 일치"
        },
        {
          "id": "V2-AUTH-06",
          "test": "test_06_origin_required_for_login",
          "description": "누락·악성·유사 도메인·null origin 거부"
        },
        {
          "id": "V2-AUTH-07",
          "test": "test_07_strict_json",
          "description": "중복 키·알 수 없는 필드·UTF-8·JSON 형식 거부"
        },
        {
          "id": "V2-AUTH-08",
          "test": "test_08_content_type_and_size",
          "description": "Content-Type 및 본문 크기 제한"
        },
        {
          "id": "V2-AUTH-09",
          "test": "test_09_utf8_field_limits",
          "description": "이메일·비밀번호 UTF-8 바이트 제한"
        },
        {
          "id": "V2-AUTH-10",
          "test": "test_10_password_is_not_trimmed",
          "description": "비밀번호 원문 공백 보존"
        },
        {
          "id": "V2-AUTH-11",
          "test": "test_11_session_rotation_revokes_previous_cookie",
          "description": "재로그인 시 세션·CSRF 교체 및 이전 세션 폐기"
        },
        {
          "id": "V2-AUTH-12",
          "test": "test_12_csrf_failure_preserves_session",
          "description": "CSRF 거부 후 세션 유지"
        },
        {
          "id": "V2-AUTH-13",
          "test": "test_13_logout_origin_failure_preserves_session",
          "description": "로그아웃 origin 거부 후 세션 유지"
        },
        {
          "id": "V2-AUTH-14",
          "test": "test_14_logout_revokes_stolen_cookie_and_is_idempotent",
          "description": "복제 쿠키 재사용 거부·멱등 로그아웃"
        },
        {
          "id": "V2-AUTH-15",
          "test": "test_15_logout_does_not_revoke_other_browser",
          "description": "다른 브라우저의 독립 세션 보존"
        },
        {
          "id": "V2-AUTH-16",
          "test": "test_16_csrf_is_bound_to_session",
          "description": "다른 세션의 CSRF 토큰 재사용 거부"
        },
        {
          "id": "V2-AUTH-17",
          "test": "test_17_methods_and_paths",
          "description": "메서드·경로 오류"
        },
        {
          "id": "V2-AUTH-18",
          "test": "test_18_absolute_expiry_is_not_extended_by_reads",
          "description": "조회에도 연장되지 않는 절대 만료"
        },
        {
          "id": "V2-AUTH-19",
          "test": "test_19_rate_limit_ignores_untrusted_forwarded_address",
          "description": "peer IP 실패 제한·재시도 시간·창 만료 후 복구"
        }
      ]
    },
    {
      "id": "shared-postgres",
      "kind": "unittest",
      "source": "tests/postgres_conformance.py",
      "class": "SharedPostgresContract",
      "scope": "mixed-backends",
      "cases": [
        {
          "id": "PG-SHARED-01",
          "test": "test_01_cross_language_login_lookup_logout",
          "description": "Python 발급 세션을 네 언어에서 조회하고 Java가 폐기한 결과를 공유"
        },
        {
          "id": "PG-SHARED-02",
          "test": "test_02_all_issuers_use_shared_users_and_hashed_tokens",
          "description": "모든 언어에서 두 번째 사용자·SHA-256 세션 해시와 임시 Unicode 계정의 실제 로그인·정규화를 검증"
        },
        {
          "id": "PG-SHARED-03",
          "test": "test_03_cross_language_rotation_and_csrf",
          "description": "다른 언어의 세션 교체와 이전 CSRF 거부 후 세션 유지"
        },
        {
          "id": "PG-SHARED-04",
          "test": "test_04_failure_limit_is_shared_and_resets",
          "description": "여러 언어의 로그인 실패 제한 공유와 만료 창 복구"
        },
        {
          "id": "PG-SHARED-05",
          "test": "test_05_concurrent_failures_are_atomic",
          "description": "동시 실패가 같은 peer의 정확한 횟수로 직렬화"
        },
        {
          "id": "PG-SHARED-06",
          "test": "test_06_disabled_users_and_expired_sessions",
          "description": "비활성 사용자 로그인·조회 거절, 로그아웃 CSRF 및 DB 만료"
        },
        {
          "id": "PG-SHARED-07",
          "test": "test_07_database_disconnect_fails_closed_and_recovers",
          "description": "연결 절단 시 auth·health의 일반 503·캐시 방지·쿠키 미발급과 복구 후 기존 세션 조회"
        },
        {
          "id": "PG-SHARED-08",
          "test": "test_08_corrupt_hash_is_storage_failure_without_lockout",
          "description": "비정상 PHC가 503이며 실패 횟수를 오염시키지 않음"
        }
      ]
    },
    {
      "id": "restart",
      "kind": "backend-function",
      "source": "tests/postgres_conformance.py",
      "function": "restart_checks",
      "scope": "one-per-listed-backend",
      "cases": [
        {
          "id": "PG-RESTART-PYTHON",
          "backend": "python",
          "description": "python 두 인스턴스의 공유 조회·폐기, 종료·재시작 후 같은 사용자·CSRF 세션과 health v2 조회"
        },
        {
          "id": "PG-RESTART-GO",
          "backend": "go",
          "description": "go 두 인스턴스의 공유 조회·폐기, 종료·재시작 후 같은 사용자·CSRF 세션과 health v2 조회"
        },
        {
          "id": "PG-RESTART-JAVA",
          "backend": "java",
          "description": "java 두 인스턴스의 공유 조회·폐기, 종료·재시작 후 같은 사용자·CSRF 세션과 health v2 조회"
        },
        {
          "id": "PG-RESTART-RUST",
          "backend": "rust",
          "description": "rust 두 인스턴스의 공유 조회·폐기, 종료·재시작 후 같은 사용자·CSRF 세션과 health v2 조회"
        }
      ]
    },
    {
      "id": "browser",
      "kind": "playwright",
      "source": "clients/react/tests/auth.spec.ts",
      "scope": "each-backend",
      "cases": [
        {
          "id": "PG-BROWSER-01",
          "test": "로그인, 새로고침 복원, 세션 확인과 로그아웃"
        },
        {
          "id": "PG-BROWSER-02",
          "test": "잘못된 자격 증명은 일반 오류로 표시하고 키보드로 재시도할 수 있다"
        },
        {
          "id": "PG-BROWSER-03",
          "test": "Unicode 이메일을 계약대로 서버에 전달하고 로그인한다"
        },
        {
          "id": "PG-BROWSER-04",
          "test": "로그아웃 거절 시 인증 상태를 보존한다"
        },
        {
          "id": "PG-BROWSER-05",
          "test": "상태 조회의 401을 세션 만료로 표시한다"
        },
        {
          "id": "PG-BROWSER-06",
          "test": "네트워크 오류는 로그아웃으로 처리하지 않는다"
        },
        {
          "id": "PG-BROWSER-07",
          "test": "429의 대기 시간을 표시하고 종료 후 재시도한다"
        },
        {
          "id": "PG-BROWSER-08",
          "test": "모바일 화면에서 가로 넘침 없이 입력과 버튼에 접근한다"
        }
      ]
    },
    {
      "id": "consumer",
      "kind": "playwright",
      "source": "examples/consumer-python-react/tests/consumer.spec.ts",
      "scope": "separate-consumer",
      "cases": [
        {
          "id": "PG-CONSUMER-01",
          "test": "인증 전 소비 앱 API 접근을 거절한다"
        },
        {
          "id": "PG-CONSUMER-02",
          "test": "공통 패키지로 로그인·복원·보호 API·로그아웃한다"
        },
        {
          "id": "PG-CONSUMER-03",
          "test": "두 번째 사용자는 자기 프로필을 조회한다"
        }
      ]
    }
  ],
  "supporting_checks": [
    {
      "source": "tests/conformance.py",
      "function": "run_contract"
    },
    {
      "source": "tests/conformance.py",
      "function": "run_secure_cookie_check"
    },
    {
      "source": "tests/conformance.py",
      "function": "run_browser"
    }
  ]
}
