# Copy to an ignored .env file and replace placeholders before running a worker.
# Keep actual credentials in the deployment's secret store, never in Git.
AUTH_DATABASE_URL='postgresql://mail_worker@db.example.com:5432/app?sslmode=verify-full&sslrootcert=/path/to/database-ca.pem'
AUTH_SMTP_HOST='smtp.example.com'
AUTH_SMTP_PORT='587'
AUTH_SMTP_MODE='starttls'
AUTH_SMTP_FROM='noreply@example.com'
AUTH_SMTP_USERNAME='set-in-secret-store'
AUTH_SMTP_PASSWORD='set-in-secret-store'
AUTH_MAIL_PUBLIC_ORIGIN='https://app.example.com'
AUTH_MAIL_DEMO='false'
AUTH_SMTP_TIMEOUT_SECONDS='10'
AUTH_MAIL_MAX_ATTEMPTS='5'
AUTH_MAIL_BATCH_SIZE='20'
AUTH_MAIL_POLL_SECONDS='5'
AUTH_MAIL_LEASE_SECONDS='330'
# Optional for a private SMTP CA. Leave unset to use system trust roots.
# AUTH_SMTP_CA_FILE='/path/to/smtp-ca.pem'
