{
  "name": "@ugauga/feature-standards-core",
  "version": "0.1.0",
  "description": "Contract-tested authorization and listing helpers for JavaScript and TypeScript",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./authorization": {
      "types": "./src/authorization.d.mts",
      "import": "./src/authorization.mjs"
    },
    "./listing": {
      "types": "./src/listing.d.mts",
      "import": "./src/listing.mjs"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "author": {
    "name": "jongko54",
    "url": "https://github.com/jongko54"
  },
  "keywords": [
    "jongko54",
    "feature-standards",
    "authorization",
    "pagination",
    "rbac",
    "typescript",
    "ai"
  ],
  "files": [
    "src/*.mjs",
    "src/*.d.mts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jongko54/feature-standards.git",
    "directory": "libraries/typescript"
  },
  "homepage": "https://github.com/jongko54/feature-standards/tree/main/libraries/typescript",
  "bugs": {
    "url": "https://github.com/jongko54/feature-standards/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
