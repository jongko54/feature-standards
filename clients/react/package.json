{
  "name": "@ugauga/feature-standards-react-auth",
  "private": false,
  "version": "0.1.4",
  "type": "module",
  "description": "Session authentication API client by jongko54 with TypeScript types for React and browser apps",
  "license": "MIT",
  "author": {"name": "jongko54", "url": "https://github.com/jongko54"},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jongko54/feature-standards.git",
    "directory": "clients/react"
  },
  "homepage": "https://github.com/jongko54/feature-standards#readme",
  "keywords": ["authentication", "session", "csrf", "react", "typescript", "feature-standards", "jongko54"],
  "main": "./lib/api.js",
  "types": "./lib/api.d.ts",
  "exports": {
    ".": {"types": "./lib/api.d.ts", "import": "./lib/api.js"},
    "./api": {"types": "./lib/api.d.ts", "import": "./lib/api.js"}
  },
  "files": ["lib/api.js", "lib/api.d.ts", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"},
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && tsc --noEmit && vite build",
    "build:lib": "tsc -p tsconfig.lib.json",
    "prepare": "npm run build:lib",
    "prepack": "npm run build:lib",
    "prepublishOnly": "npm test && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "preview": "vite preview",
    "test": "tsx --test src/api.test.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
