{
  "name": "feature-standards",
  "version": "0.4.0",
  "featureStandards": {
    "coreStarterProtocolVersion": 1
  },
  "description": "Cross-language reusable feature contracts and AI integration context by jongko54",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "jongko54",
    "url": "https://github.com/jongko54"
  },
  "keywords": [
    "feature-standards",
    "jongko54",
    "ai",
    "cross-language",
    "contracts",
    "openapi",
    "conformance",
    "python",
    "go",
    "java",
    "rust",
    "react"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "feature-standards": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src/cli.mjs",
    "src/index.mjs",
    "src/workflow.mjs",
    "src/core-generator.mjs",
    "src/core-project.mjs",
    "src/core-protocol.mjs",
    "src/core-source.mjs",
    "src/core-process.mjs",
    "src/core-check.mjs",
    "templates/core",
    "snapshot",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "check:pack": "node test/packed.mjs",
    "check:core-generated": "node test/core-generated.mjs",
    "check:core-installed": "node test/core-installed.mjs",
    "pack:bootstrap": "node scripts/pack-bootstrap.mjs",
    "check:bootstrap": "node test/bootstrap.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jongko54/feature-standards.git",
    "directory": "packages/feature-standards"
  },
  "homepage": "https://github.com/jongko54/feature-standards#readme",
  "bugs": {
    "url": "https://github.com/jongko54/feature-standards/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
